    <bpmn:group id="Group_01b2fmz" categoryValueRef="CategoryValue_001ag97" />
    <bpmn:group id="Group_14b7tg0" categoryValueRef="CategoryValue_16d959j" />
    <bpmn:group id="Group_01ul7om" categoryValueRef="CategoryValue_13ua4fq" />
    <bpmn:group id="Group_0ncrh2k" categoryValueRef="CategoryValue_1yf1eaw" />
    <bpmn:group id="Group_0v79217" categoryValueRef="CategoryValue_1dzgyft" />
    <bpmn:group id="Group_1fdn73e" categoryValueRef="CategoryValue_10f5aca" />
    <bpmn:group id="Group_1tquvs7" categoryValueRef="CategoryValue_1ywzo3r" />
    <bpmn:group id="Group_0brqv4f" categoryValueRef="CategoryValue_089acmk" />
    <bpmn:group id="Group_0sh6kbt" categoryValueRef="CategoryValue_0ix832p" />
    <bpmn:group id="Group_19do9wb" categoryValueRef="CategoryValue_19pchqc" />
    <bpmn:group id="Group_1imxpjj" categoryValueRef="CategoryValue_0bin1kt" />
    <bpmn:textAnnotation id="TextAnnotation_0h1v9th">
      <bpmn:text>новый заказ на производство - обработка заявки в течение дня
*зависит от загруженности</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0mfvxvj">
      <bpmn:text>запрашивается у отдела разработки</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0pzh3dl">
      <bpmn:text>домунетация должна быть как в электронном виде, так и на бумажном нгосителе


комплектующие должны иметь следующие атрибуты: покупные комплектующие изделия, покупные материалы, изделия собственного аддитивного производства, изделия собственного композитного производства</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0juwvbb">
      <bpmn:text>принимается главным конструктором совместно с руководителем производства - обговариваются условия, нюансы</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ef1zbs">
      <bpmn:text>запрос направляется в отдел разработки</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r8zndt">
      <bpmn:text>на основе комплектовочной ведомости</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0cpxxjn">
      <bpmn:text>отправляется в отдел закупок</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_14uyqna">
      <bpmn:text>в ведомости указывается перечень отсутствующих комплектующих и ожидаемая дата поставки</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16cpxxa">
      <bpmn:text>указываются сроки, участок ответственный за производство</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0keel7a">
      <bpmn:text>сроки поставки отсутствующих комплектующих влияют на формирование плана производства</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:group id="Group_1b40uwr" categoryValueRef="CategoryValue_1jul2pz" />
    <bpmn:group id="Group_1d6ewel" categoryValueRef="CategoryValue_1oz7d7q" />
    <bpmn:group id="Group_0k8lyqr" categoryValueRef="CategoryValue_0it9o86" />
    <bpmn:group id="Group_17j2oxj" categoryValueRef="CategoryValue_1fz022i" />
    <bpmn:group id="Group_1o8crtl" categoryValueRef="CategoryValue_1srv391" />
    <bpmn:group id="Group_0rmax9t" categoryValueRef="CategoryValue_0czrksu" />
    <bpmn:group id="Group_0jic563" categoryValueRef="CategoryValue_1r7e5qb" />
    <bpmn:group id="Group_0sjvkvx" categoryValueRef="CategoryValue_12elpig" />
    <bpmn:group id="Group_098dkpa" categoryValueRef="CategoryValue_0kwe1l7" />
    <bpmn:group id="Group_0na3qyg" categoryValueRef="CategoryValue_0w0srcu" />
    <bpmn:group id="Group_0kah7wi" categoryValueRef="CategoryValue_08nh3vf" />
    <bpmn:group id="Group_0z2n7hm" categoryValueRef="CategoryValue_0rj4wt5" />
    <bpmn:textAnnotation id="TextAnnotation_0y5nrpn">
      <bpmn:text>сейчас приходит в whatsapp в формате фото/текста, иногда устно</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0e32hbw">
      <bpmn:text>whatsapp/почта</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0q81ioc">
      <bpmn:text>производство ставит резолюцию на счете</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1iknku9">
      <bpmn:text>частично принимается отделом снабжения, частично кладовщик, ОТК</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1jkkad9">
      <bpmn:text>фиксируются в excel-таблице</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1dzevq5">
      <bpmn:text>фиксируется в excel- таблице</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1511nso">
      <bpmn:text>есть договоры с поставщиками, продлеваются ежегодно</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0subdla">
      <bpmn:text>решение принимается совместно с отделом производства</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_10rgkwi">
      <bpmn:text>снабжение, отдел производства, бухгалтерия - проверяется благонадежность поставщика</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1007qmn">
      <bpmn:text>передача договора юристу на проверку - юрист рекомендует с кем необходимо согласовать договор</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0tie951">
      <bpmn:text>дает рекомендации по действиям/ставит задачи</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1e594lf">
      <bpmn:text>чаще всего направляется нескольким поставщикам, выбор зависит от цен, главным образом от сроков</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_100wyic">
      <bpmn:text>договор может быть подписан позже - параллельно процессу поставки товара</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_092izts">
      <bpmn:text>есть сложности с отслеживанием загрузки сотрудников, где требуется помощь (коммуникация, сроки)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_056d694">
      <bpmn:text>постоплата/приобретение за нал. - далее осуществляется компенсация через бухгалтерию</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:group id="Group_0ev3cd7" categoryValueRef="CategoryValue_1wvyrff" />
    <bpmn:group id="Group_0p38kg7" categoryValueRef="CategoryValue_0zu2b8w" />
    <bpmn:group id="Group_1nzqfap" categoryValueRef="CategoryValue_1gpurmd" />
    <bpmn:group id="Group_1ufwezm" categoryValueRef="CategoryValue_0qm5tvm" />
    <bpmn:group id="Group_07kho7p" categoryValueRef="CategoryValue_0y9o804" />
    <bpmn:group id="Group_14gln3i" categoryValueRef="CategoryValue_1kp5yx2" />
    <bpmn:textAnnotation id="TextAnnotation_0y0w5dx">
      <bpmn:text>ярлык, наклейки, любое обозначение, что бы было видно</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ww2j58">
      <bpmn:text>перечни вк, спецификация, кд, инструкции</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1jm4m10">
      <bpmn:text>перечни вк, спецификация, кд</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0jduo5l">
      <bpmn:text>копия накладной, и/ или акт приема – передачи, сопроводительные документы от поставщика или производства (паспорт и пр.)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:group id="Group_115hmb1" categoryValueRef="CategoryValue_095u27o" />
